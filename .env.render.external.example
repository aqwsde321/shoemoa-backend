# Local PC 또는 외부 클라이언트에서 Render DB에 접속할 때 사용
SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:postgresql://<RENDER_EXTERNAL_DB_HOST>:5432/<RENDER_DB_NAME>
SPRING_DATASOURCE_USERNAME=<RENDER_DB_USER>
SPRING_DATASOURCE_PASSWORD=<RENDER_DB_PASSWORD>
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# JWT / Admin
JWT_SECRET=<CHANGE_ME>
ADMIN_PW=<CHANGE_ME>

# CORS / Base URL
APP_BASE_URL=http://localhost:3000
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Email
GMAIL_USERNAME=<GMAIL_ADDRESS>
GMAIL_APP_PASSWORD=<GMAIL_APP_PASSWORD>
