# Spring
SPRING_PROFILES_ACTIVE=prod

# Database (Render PostgreSQL internal connection)
SPRING_DATASOURCE_URL=jdbc:postgresql://<RENDER_INTERNAL_DB_HOST>:5432/<RENDER_DB_NAME>
SPRING_DATASOURCE_USERNAME=<RENDER_DB_USER>
SPRING_DATASOURCE_PASSWORD=<RENDER_DB_PASSWORD>

# JPA
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# JWT / Admin
JWT_SECRET=<CHANGE_ME>
ADMIN_PW=<CHANGE_ME>

# CORS / Base URL
APP_BASE_URL=https://<YOUR_FRONTEND_DOMAIN>
APP_CORS_ALLOWED_ORIGINS=https://<YOUR_FRONTEND_DOMAIN>

# Email (optional)
GMAIL_USERNAME=<GMAIL_ADDRESS>
GMAIL_APP_PASSWORD=<GMAIL_APP_PASSWORD>
